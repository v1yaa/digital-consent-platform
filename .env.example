# Environment variable template for the Digital Consent Platform
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Flask secret key – change this to a random string in production
SECRET_KEY=change-me-to-a-random-secret

# SQLite database path (used when running locally without Docker)
# For Docker, this is set in docker-compose.yml
DATABASE_URL=sqlite:///consent.db

# Port exposed on the host machine (Docker Compose)
HOST_PORT=8080

# Flask debug mode – set to false in production
FLASK_DEBUG=false
